{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npx vitest *)",
      "Bash(npm view *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run format)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm test)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run build)",
      "PowerShell(npx vitest *)",
      "PowerShell(npm view *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh api * -X *)",
      "PowerShell(gh api * -X *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-edited-file.mjs"],
            "timeout": 90,
            "statusMessage": "Prettier + ESLint on edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-on-stop.mjs"],
            "timeout": 240,
            "statusMessage": "tsc + related tests"
          }
        ]
      }
    ]
  }
}
