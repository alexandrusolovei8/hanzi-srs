{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npx vitest *)",
      "Bash(npm view *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run format)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm test)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run build)",
      "PowerShell(npx vitest *)",
      "PowerShell(npm view *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh api * -X *)",
      "PowerShell(gh api * -X *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
